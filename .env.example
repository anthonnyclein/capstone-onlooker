# CPMS Application Environment Configuration

# Server Port and Host
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# PostgreSQL Database Connection URL
# For Dokploy internal PostgreSQL: postgres://postgres:<password>@<dokploy-db-host>:5432/<database_name>
# For local Docker Compose: postgres://postgres:postgres@db:5432/cpms_db
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cpms_db

# Security
JWT_SECRET=super_secret_jwt_random_key_replace_in_production

# Optional Postgres Compose Credentials (if deploying via docker-compose.yml)
POSTGRES_DB=cpms_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_PORT=5432
